<?xml version="1.0" encoding="utf-8"?>
<!-- Se infla sin padre, así que el margen va como padding de este contenedor -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/espacio_grande"
    android:paddingTop="@dimen/espacio_chico"
    android:paddingEnd="@dimen/espacio_grande">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            style="@style/EtiquetaCampo"
            android:layout_marginTop="0dp"
            android:text="@string/login_url_comando_central" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:hintEnabled="false">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editBackendUrl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/login_url_comando_central"
                android:inputType="textUri" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            style="@style/EtiquetaCampo"
            android:text="@string/enlace_modo" />

        <RadioGroup
            android:id="@+id/grupoModo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/radioAuto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/enlace_auto" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="36dp"
                android:text="@string/enlace_auto_ayuda"
                android:textAppearance="@style/TextAppearance.DronePatrol.Apagado" />

            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/radioCable"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espacio_chico"
                android:text="@string/enlace_cable" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="36dp"
                android:text="@string/enlace_cable_ayuda"
                android:textAppearance="@style/TextAppearance.DronePatrol.Apagado" />

            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/radioRed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espacio_chico"
                android:text="@string/enlace_red" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="36dp"
                android:text="@string/enlace_red_ayuda"
                android:textAppearance="@style/TextAppearance.DronePatrol.Apagado" />
        </RadioGroup>

        <TextView
            style="@style/EtiquetaCampo"
            android:text="@string/enlace_url_deteccion" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutUrlDeteccion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/espacio_chico"
            app:hintEnabled="false">

            <!-- La pista la carga FieldMenuActivity desde Config -->
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editUrlDeteccion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textUri" />
        </com.google.android.material.textfield.TextInputLayout>
    </LinearLayout>
</ScrollView>
