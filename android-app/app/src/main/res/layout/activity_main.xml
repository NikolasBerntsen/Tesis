<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Conexión"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/editBackendUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="URL del Comando Central"
            android:inputType="textUri"
            android:text="http://10.0.2.2:4000" />

        <EditText
            android:id="@+id/editLaptopUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="URL del software de detección (laptop)"
            android:inputType="textUri"
            android:text="ws://10.0.2.2:8765" />

        <Button
            android:id="@+id/btnConnect"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Conectar" />

        <TextView
            android:id="@+id/txtConnStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Desconectado" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Patrullaje"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spinnerRoutes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <Button
            android:id="@+id/btnStartPatrol"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:enabled="false"
            android:text="Comenzar patrullaje" />

        <TextView
            android:id="@+id/txtState"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Estado: en base"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtBattery"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Batería: —" />

        <TextView
            android:id="@+id/txtSignal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Señal RC: —" />

        <LinearLayout
            android:id="@+id/sectionSim"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Simulación (solo build mock)"
                android:textStyle="bold" />

            <Switch
                android:id="@+id/switchSignalLoss"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Simular pérdida de señal RC" />

            <Button
                android:id="@+id/btnLowBattery"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Forzar batería baja" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Registro local"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtLocalLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textSize="11sp" />
    </LinearLayout>
</ScrollView>
