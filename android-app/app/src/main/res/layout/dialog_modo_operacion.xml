<?xml version="1.0" encoding="utf-8"?>
<!-- Se infla sin padre, así que el margen va como padding de este contenedor -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/espacio_grande"
    android:paddingTop="@dimen/espacio_chico"
    android:paddingEnd="@dimen/espacio_grande">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_dron"
            app:tint="@color/acento" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/espacio_medio"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtDron"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                android:textColor="@color/texto" />

            <TextView
                android:id="@+id/txtDetalleDron"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.DronePatrol.Mono" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/txtUbicacion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/espacio_chico"
        android:textAppearance="@style/TextAppearance.DronePatrol.Apagado" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/espacio_grande"
        android:text="@string/modo_pregunta"
        android:textAppearance="@style/TextAppearance.Material3.TitleSmall"
        android:textColor="@color/texto" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnModoDespliegue"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/espacio_medio"
        android:text="@string/modo_despliegue"
        app:icon="@drawable/ic_despegar"
        app:iconGravity="textStart" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/modo_despliegue_ayuda"
        android:textAppearance="@style/TextAppearance.DronePatrol.Apagado" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnModoPrueba"
        style="@style/Widget.DronePatrol.Boton.Secundario"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/espacio"
        android:text="@string/modo_prueba" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="@dimen/espacio_chico"
        android:text="@string/modo_prueba_ayuda"
        android:textAppearance="@style/TextAppearance.DronePatrol.Apagado" />
</LinearLayout>
