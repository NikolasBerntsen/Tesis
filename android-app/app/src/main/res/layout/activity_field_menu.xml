<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/espacio"
        android:paddingTop="@dimen/espacio_grande"
        android:paddingEnd="@dimen/espacio"
        android:paddingBottom="@dimen/espacio_grande">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/menu_campo_titulo"
            android:textAppearance="@style/TextAppearance.DronePatrol.Titulo" />

        <!-- Quién está operando y cuánto le queda de sesión -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacio">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/espacio">

                <TextView
                    style="@style/TituloTarjeta"
                    android:text="@string/menu_campo_sesion" />

                <TextView
                    android:id="@+id/txtQuien"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                    android:textColor="@color/texto" />

                <View
                    style="@style/Widget.DronePatrol.Divisor"
                    android:layout_marginTop="@dimen/espacio_medio"
                    android:layout_marginBottom="@dimen/espacio_medio" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="@dimen/icono"
                        android:layout_height="@dimen/icono"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_reloj"
                        app:tint="@color/texto_suave" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/espacio_medio"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/TituloTarjeta"
                            android:layout_marginBottom="0dp"
                            android:text="@string/menu_campo_restante" />

                        <TextView
                            android:id="@+id/txtCuentaRegresiva"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.DronePatrol.Cifra"
                            android:textColor="@color/acento" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/espacio_chico"
                    android:text="@string/menu_campo_restante_ayuda"
                    android:textAppearance="@style/TextAppearance.DronePatrol.Apagado" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Acción principal: emparejar el dron que se va a desplegar -->
        <TextView
            style="@style/TituloTarjeta"
            android:layout_marginTop="@dimen/espacio_grande"
            android:text="@string/menu_campo_desplegar" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEscanear"
            style="@style/Widget.DronePatrol.Boton.Principal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/menu_campo_escanear"
            app:icon="@drawable/ic_qr"
            app:iconGravity="textStart" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacio_chico"
            android:text="@string/menu_campo_escanear_ayuda"
            android:textAppearance="@style/TextAppearance.DronePatrol.Apagado" />

        <TextView
            android:id="@+id/txtEstado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacio_medio"
            android:textAppearance="@style/TextAppearance.DronePatrol.Cuerpo"
            android:textColor="@color/estado_alerta" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnIdentificador"
            style="@style/Widget.DronePatrol.Boton.Secundario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacio"
            android:text="@string/menu_campo_identificador" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConfiguracion"
            style="@style/Widget.DronePatrol.Boton.Secundario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacio_medio"
            android:text="@string/menu_campo_configuracion"
            app:icon="@drawable/ic_ajustes"
            app:iconGravity="textStart" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCerrarSesion"
            style="@style/Widget.DronePatrol.Boton.Texto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacio"
            android:text="@string/menu_campo_cerrar_sesion"
            app:icon="@drawable/ic_cerrar_sesion"
            app:iconGravity="textStart" />
    </LinearLayout>
</ScrollView>
