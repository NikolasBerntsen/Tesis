<?xml version="1.0" encoding="utf-8"?>
<!-- Se infla sin padre, así que el margen va como padding de este contenedor -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/espacio_grande"
    android:paddingTop="@dimen/espacio_chico"
    android:paddingEnd="@dimen/espacio_grande">

    <TextView
        style="@style/EtiquetaCampo"
        android:layout_marginTop="0dp"
        android:text="@string/main_nombre_visible" />

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:hintEnabled="false">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/editDisplayName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textCapWords"
            android:maxLength="40" />
    </com.google.android.material.textfield.TextInputLayout>
</LinearLayout>
