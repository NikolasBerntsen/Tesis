<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Consola de campo: oscura siempre. Hereda de Dark y no de DayNight a
         propósito: el contraste alto a pleno sol es el requisito, y un tema
         claro que el sistema cambie solo lo rompería. -->
    <style name="Theme.DronePatrol" parent="Theme.Material3.Dark.NoActionBar">

        <item name="colorPrimary">@color/acento</item>
        <item name="colorOnPrimary">@color/sobre_acento</item>
        <item name="colorPrimaryContainer">@color/acento_tenue</item>
        <item name="colorOnPrimaryContainer">@color/acento</item>

        <item name="colorSecondary">@color/texto_medio</item>
        <item name="colorOnSecondary">@color/fondo</item>
        <item name="colorSecondaryContainer">@color/superficie_maxima</item>
        <item name="colorOnSecondaryContainer">@color/texto</item>

        <item name="colorTertiary">@color/estado_info</item>
        <item name="colorOnTertiary">@color/fondo</item>
        <item name="colorTertiaryContainer">@color/estado_info_tenue</item>
        <item name="colorOnTertiaryContainer">@color/texto</item>

        <item name="colorError">@color/estado_peligro</item>
        <item name="colorOnError">@color/fondo</item>
        <item name="colorErrorContainer">@color/estado_peligro_tenue</item>
        <item name="colorOnErrorContainer">@color/estado_peligro</item>

        <item name="android:colorBackground">@color/fondo</item>
        <item name="colorOnBackground">@color/texto</item>
        <item name="colorSurface">@color/superficie</item>
        <item name="colorOnSurface">@color/texto</item>
        <item name="colorSurfaceVariant">@color/superficie_alta</item>
        <item name="colorOnSurfaceVariant">@color/texto_medio</item>
        <item name="colorSurfaceDim">@color/fondo</item>
        <item name="colorSurfaceBright">@color/superficie_maxima</item>
        <item name="colorSurfaceContainerLowest">@color/fondo</item>
        <item name="colorSurfaceContainerLow">@color/superficie</item>
        <item name="colorSurfaceContainer">@color/superficie</item>
        <item name="colorSurfaceContainerHigh">@color/superficie_alta</item>
        <item name="colorSurfaceContainerHighest">@color/superficie_maxima</item>
        <item name="colorSurfaceInverse">@color/texto</item>
        <item name="colorOnSurfaceInverse">@color/fondo</item>

        <item name="colorOutline">@color/borde_fuerte</item>
        <item name="colorOutlineVariant">@color/borde</item>

        <item name="colorControlNormal">@color/texto_medio</item>
        <item name="colorControlActivated">@color/acento</item>
        <item name="colorControlHighlight">@color/pulsacion_clara</item>

        <item name="android:textColorPrimary">@color/texto</item>
        <item name="android:textColorSecondary">@color/texto_medio</item>
        <item name="android:textColorTertiary">@color/texto_suave</item>
        <item name="android:textColorHint">@color/texto_suave</item>
        <item name="android:textColorLink">@color/acento</item>
        <item name="android:textColorHighlight">@color/acento_tenue</item>

        <item name="android:windowBackground">@color/fondo</item>
        <item name="android:statusBarColor">@color/fondo</item>
        <item name="android:navigationBarColor">@color/fondo</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>

        <!-- Widgets por defecto: así un layout nuevo ya sale con la estética -->
        <item name="materialCardViewStyle">@style/Widget.DronePatrol.Tarjeta</item>
        <item name="materialButtonStyle">@style/Widget.DronePatrol.Boton</item>
        <item name="materialButtonOutlinedStyle">@style/Widget.DronePatrol.Boton.Secundario</item>
        <item name="borderlessButtonStyle">@style/Widget.DronePatrol.Boton.Texto</item>
        <item name="textInputStyle">@style/Widget.DronePatrol.CampoTexto</item>
        <item name="toolbarStyle">@style/Widget.DronePatrol.BarraSuperior</item>
        <item name="appBarLayoutStyle">@style/Widget.DronePatrol.BarraSuperior.Contenedor</item>
        <item name="linearProgressIndicatorStyle">@style/Widget.DronePatrol.BarraProgreso</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.DronePatrol.Dialogo</item>
        <item name="materialButtonToggleGroupStyle">@style/Widget.DronePatrol.Pestanias</item>
    </style>

    <!-- ==================== Tipografía ==================== -->

    <style name="TextAppearance.DronePatrol.Titulo" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textColor">@color/texto</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <!-- Cifra clave (batería, altura, cuenta regresiva): monoespaciada para que
         los dígitos no bailen al cambiar -->
    <style name="TextAppearance.DronePatrol.Cifra" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:fontFamily">monospace</item>
        <item name="fontFamily">monospace</item>
        <item name="android:textColor">@color/texto</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="TextAppearance.DronePatrol.CifraChica" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:fontFamily">monospace</item>
        <item name="fontFamily">monospace</item>
        <item name="android:textColor">@color/texto</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <!-- Versalitas: encabezados de tarjeta y etiquetas de campo -->
    <style name="TextAppearance.DronePatrol.Versalita" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.1</item>
        <item name="android:textColor">@color/texto_suave</item>
    </style>

    <style name="TextAppearance.DronePatrol.Cuerpo" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/texto</item>
    </style>

    <style name="TextAppearance.DronePatrol.Apagado" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/texto_medio</item>
    </style>

    <!-- Monoespaciada para hashes, coordenadas y el registro -->
    <style name="TextAppearance.DronePatrol.Mono" parent="TextAppearance.Material3.BodySmall">
        <item name="android:fontFamily">monospace</item>
        <item name="fontFamily">monospace</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/texto_medio</item>
    </style>

    <!-- ==================== Widgets ==================== -->

    <style name="Widget.DronePatrol.Tarjeta" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/superficie</item>
        <item name="strokeColor">@color/borde</item>
        <item name="strokeWidth">@dimen/borde</item>
        <item name="cardCornerRadius">@dimen/radio</item>
        <item name="cardElevation">0dp</item>
    </style>

    <!-- Botón principal: ámbar con texto oscuro (contraste 11:1) -->
    <style name="Widget.DronePatrol.Boton" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/relleno_boton_principal</item>
        <item name="android:textColor">@color/texto_boton_principal</item>
        <item name="iconTint">@color/texto_boton_principal</item>
        <item name="rippleColor">@color/pulsacion_oscura</item>
        <item name="cornerRadius">@dimen/radio_chico</item>
        <item name="elevation">0dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minHeight">@dimen/alto_boton</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- La acción de vuelo principal: más alta todavía -->
    <style name="Widget.DronePatrol.Boton.Principal" parent="Widget.DronePatrol.Boton">
        <item name="android:minHeight">@dimen/alto_boton_principal</item>
        <item name="android:textSize">17sp</item>
    </style>

    <!-- Botón secundario: borde claro sobre la tarjeta -->
    <style name="Widget.DronePatrol.Boton.Secundario" parent="Widget.Material3.Button.OutlinedButton">
        <item name="backgroundTint">@android:color/transparent</item>
        <item name="strokeColor">@color/borde_boton_secundario</item>
        <item name="strokeWidth">@dimen/borde</item>
        <item name="android:textColor">@color/texto_boton_secundario</item>
        <item name="iconTint">@color/texto_boton_secundario</item>
        <item name="rippleColor">@color/pulsacion_clara</item>
        <item name="cornerRadius">@dimen/radio_chico</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minHeight">@dimen/alto_boton</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
    </style>

    <!-- Acciones de seguridad (volver a base, aterrizar): rojo, nunca relleno -->
    <style name="Widget.DronePatrol.Boton.Peligro" parent="Widget.DronePatrol.Boton.Secundario">
        <item name="strokeColor">@color/borde_boton_peligro</item>
        <item name="android:textColor">@color/texto_boton_peligro</item>
        <item name="iconTint">@color/texto_boton_peligro</item>
        <item name="rippleColor">@color/estado_peligro_tenue</item>
    </style>

    <style name="Widget.DronePatrol.Boton.Texto" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">@color/acento</item>
        <item name="iconTint">@color/acento</item>
        <item name="rippleColor">@color/acento_tenue</item>
        <item name="cornerRadius">@dimen/radio_chico</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Widget.DronePatrol.Boton.Dialogo" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:textColor">@color/acento</item>
        <item name="rippleColor">@color/acento_tenue</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- Las dos vistas de la pantalla de operación -->
    <style name="Widget.DronePatrol.Pestanias" parent="Widget.Material3.MaterialButtonToggleGroup">
        <item name="singleSelection">true</item>
        <item name="selectionRequired">true</item>
    </style>

    <style name="Widget.DronePatrol.Boton.Pestania" parent="Widget.Material3.Button.OutlinedButton">
        <item name="backgroundTint">@color/relleno_pestania</item>
        <item name="strokeColor">@color/borde</item>
        <item name="strokeWidth">@dimen/borde</item>
        <item name="android:textColor">@color/texto_pestania</item>
        <item name="iconTint">@color/texto_pestania</item>
        <item name="rippleColor">@color/pulsacion_clara</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Widget.DronePatrol.CampoTexto" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/fondo</item>
        <item name="boxStrokeColor">@color/borde_campo</item>
        <item name="boxStrokeErrorColor">@color/estado_peligro</item>
        <item name="boxStrokeWidth">@dimen/borde</item>
        <item name="boxStrokeWidthFocused">@dimen/borde_fuerte</item>
        <item name="boxCornerRadiusTopStart">@dimen/radio_chico</item>
        <item name="boxCornerRadiusTopEnd">@dimen/radio_chico</item>
        <item name="boxCornerRadiusBottomStart">@dimen/radio_chico</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/radio_chico</item>
        <item name="hintTextColor">@color/acento</item>
        <item name="android:textColorHint">@color/texto_suave</item>
        <item name="endIconTint">@color/texto_medio</item>
    </style>

    <style name="Widget.DronePatrol.CampoTexto.Menu" parent="Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
        <item name="boxBackgroundColor">@color/fondo</item>
        <item name="boxStrokeColor">@color/borde_campo</item>
        <item name="boxStrokeWidth">@dimen/borde</item>
        <item name="boxStrokeWidthFocused">@dimen/borde_fuerte</item>
        <item name="boxCornerRadiusTopStart">@dimen/radio_chico</item>
        <item name="boxCornerRadiusTopEnd">@dimen/radio_chico</item>
        <item name="boxCornerRadiusBottomStart">@dimen/radio_chico</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/radio_chico</item>
        <item name="hintTextColor">@color/acento</item>
        <item name="android:textColorHint">@color/texto_suave</item>
        <item name="endIconTint">@color/texto_medio</item>
    </style>

    <style name="Widget.DronePatrol.BarraSuperior" parent="Widget.Material3.Toolbar">
        <item name="android:background">@color/fondo</item>
        <item name="titleTextColor">@color/texto</item>
        <item name="subtitleTextColor">@color/texto_medio</item>
        <item name="navigationIconTint">@color/texto_medio</item>
        <item name="titleTextAppearance">@style/TextAppearance.Material3.TitleMedium</item>
        <item name="subtitleTextAppearance">@style/TextAppearance.Material3.BodySmall</item>
    </style>

    <style name="Widget.DronePatrol.BarraSuperior.Contenedor" parent="Widget.Material3.AppBarLayout">
        <item name="android:background">@color/fondo</item>
        <item name="elevation">0dp</item>
        <item name="liftOnScroll">false</item>
    </style>

    <style name="Widget.DronePatrol.BarraProgreso" parent="Widget.Material3.LinearProgressIndicator">
        <item name="indicatorColor">@color/acento</item>
        <item name="trackColor">@color/superficie_maxima</item>
        <item name="trackThickness">@dimen/grosor_barra_progreso</item>
        <item name="trackCornerRadius">3dp</item>
    </style>

    <style name="Widget.DronePatrol.Divisor" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/borde</item>
        <item name="android:background">@color/borde</item>
    </style>

    <style name="ThemeOverlay.DronePatrol.Dialogo" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorSurface">@color/superficie_alta</item>
        <item name="colorSurfaceContainerHigh">@color/superficie_alta</item>
        <item name="android:colorBackground">@color/superficie_alta</item>
        <item name="colorOnSurface">@color/texto</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.DronePatrol.Boton.Dialogo</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.DronePatrol.Boton.Dialogo</item>
        <item name="buttonBarNeutralButtonStyle">@style/Widget.DronePatrol.Boton.Dialogo</item>
    </style>

    <!-- ==================== Estilos de layout ==================== -->

    <!-- Título que va arriba de cada campo del formulario -->
    <style name="EtiquetaCampo">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/espacio_medio</item>
        <item name="android:layout_marginBottom">6dp</item>
        <item name="android:textAppearance">@style/TextAppearance.DronePatrol.Versalita</item>
    </style>

    <style name="TituloTarjeta">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">@dimen/espacio_chico</item>
        <item name="android:textAppearance">@style/TextAppearance.DronePatrol.Versalita</item>
    </style>

    <!-- Una celda de telemetría: etiqueta chica arriba, cifra mono abajo -->
    <style name="EtiquetaTelemetria">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textAppearance">@style/TextAppearance.DronePatrol.Versalita</item>
    </style>

    <style name="CifraTelemetria">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:textAppearance">@style/TextAppearance.DronePatrol.CifraChica</item>
    </style>

    <!-- Insignia de estado (texto chico sobre un fondo tenue redondeado) -->
    <style name="Insignia">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">4dp</item>
        <item name="android:background">@drawable/fondo_insignia</item>
        <item name="android:textAppearance">@style/TextAppearance.DronePatrol.Versalita</item>
        <item name="android:textColor">@color/texto_medio</item>
    </style>

</resources>
