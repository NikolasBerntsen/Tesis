<?xml version="1.0" encoding="utf-8"?>
<!-- Consola de campo. La app se usa a pleno sol, con el teléfono enganchado al
     control: fondo oscuro de alto contraste, texto claro, y UN acento ámbar
     para lo que hay que encontrar con el pulgar sin mirar (la acción principal).
     Los colores de estado son los mismos que usa la consola web, para que
     "batería en rojo" signifique lo mismo en los dos lados. -->
<resources>

    <!-- Superficies: del fondo de ventana a la tarjeta más elevada -->
    <color name="fondo">#0C1218</color>
    <color name="superficie">#151D26</color>
    <color name="superficie_alta">#1C2733</color>
    <color name="superficie_maxima">#243140</color>

    <!-- Bordes -->
    <color name="borde">#2E3B4A</color>
    <color name="borde_fuerte">#45566A</color>

    <!-- Texto: tres niveles, todos AA sobre las superficies -->
    <color name="texto">#E8EEF4</color>
    <color name="texto_medio">#A3B1BF</color>
    <color name="texto_suave">#75859A</color>

    <!-- Acento ámbar: botones principales, selección, cifras clave -->
    <color name="acento">#F4B642</color>
    <color name="acento_oscuro">#D99A1E</color>
    <color name="acento_tenue">#2EF4B642</color>
    <!-- Texto encima del ámbar -->
    <color name="sobre_acento">#1A1200</color>

    <!-- Estados -->
    <color name="estado_ok">#3DD68C</color>
    <color name="estado_alerta">#F4B642</color>
    <color name="estado_peligro">#FF5A5A</color>
    <color name="estado_info">#5AB0FF</color>
    <color name="estado_apagado">#5A6A7B</color>

    <!-- Versión tenue de cada estado, para el fondo de una insignia -->
    <color name="estado_ok_tenue">#263DD68C</color>
    <color name="estado_alerta_tenue">#26F4B642</color>
    <color name="estado_peligro_tenue">#26FF5A5A</color>
    <color name="estado_info_tenue">#265AB0FF</color>

    <!-- Pulsaciones -->
    <color name="pulsacion_clara">#33E8EEF4</color>
    <color name="pulsacion_oscura">#331A1200</color>

    <!-- El visor de video: negro de verdad, para que el cuadro se vea entero -->
    <color name="video_fondo">#000000</color>

</resources>
