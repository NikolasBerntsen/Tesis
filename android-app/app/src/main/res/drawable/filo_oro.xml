<?xml version="1.0" encoding="utf-8"?>
<!-- Filo dorado reutilizable: 2dp de lámina de oro alrededor de una superficie
     de mármol. Es la marca de "activo / seleccionado"; el oro nunca rellena. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:centerColor="@color/oro_lamina_medio"
                android:endColor="@color/oro_oscuro"
                android:startColor="@color/oro_lamina_reflejo"
                android:type="linear" />
            <corners android:radius="@dimen/radio" />
        </shape>
    </item>
    <item
        android:bottom="@dimen/grosor_filo"
        android:left="@dimen/grosor_filo"
        android:right="@dimen/grosor_filo"
        android:top="@dimen/grosor_filo">
        <shape android:shape="rectangle">
            <solid android:color="@color/marmol_1" />
            <corners android:radius="@dimen/radio_chico" />
        </shape>
    </item>
</layer-list>
