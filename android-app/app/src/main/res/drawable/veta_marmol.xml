<?xml version="1.0" encoding="utf-8"?>
<!-- Veta de la piedra. Va en el límite de lo perceptible (alfa <= .05) a
     propósito: si llega a leerse como un dibujo, dejó de ser mármol y pasó a
     ser textura. Se estira para cubrir la vista; la veta es orgánica, así que
     la deformación no se nota. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="360dp"
    android:height="720dp"
    android:viewportWidth="360"
    android:viewportHeight="720">

    <!-- Nubes: manchas anchas que le dan cuerpo a la placa -->
    <path
        android:fillAlpha="0.03"
        android:fillColor="@color/veta_fuerte"
        android:pathData="M-40,-40 L400,-40 L400,62 C320,42 280,124 190,102 C110,84 60,152 -40,112 Z" />
    <path
        android:fillAlpha="0.025"
        android:fillColor="@color/veta_fuerte"
        android:pathData="M-40,430 C40,400 90,470 180,450 C270,430 320,500 400,470 L400,620 C310,650 250,570 160,600 C80,628 30,560 -40,590 Z" />
    <path
        android:fillAlpha="0.03"
        android:fillColor="@color/veta_fuerte"
        android:pathData="M-40,760 L400,760 L400,662 C330,692 270,622 180,652 C100,678 40,622 -40,652 Z" />

    <!-- Vetas: los cortes finos de la piedra -->
    <path
        android:pathData="M-20,140 C60,110 100,190 175,165 C250,140 300,75 380,105"
        android:strokeAlpha="0.05"
        android:strokeColor="@color/veta_fuerte"
        android:strokeWidth="1.2" />
    <path
        android:pathData="M-20,300 C70,330 130,255 210,285 C280,311 320,260 380,280"
        android:strokeAlpha="0.045"
        android:strokeColor="@color/veta_fuerte"
        android:strokeWidth="1" />
    <path
        android:pathData="M-20,505 C80,470 140,545 220,520 C290,498 330,545 380,525"
        android:strokeAlpha="0.05"
        android:strokeColor="@color/veta_fuerte"
        android:strokeWidth="1.3" />
    <path
        android:pathData="M40,-20 C70,80 20,150 60,240 C95,318 55,390 90,470 C120,538 90,620 120,760"
        android:strokeAlpha="0.035"
        android:strokeColor="@color/veta_fuerte"
        android:strokeWidth="0.9" />
    <path
        android:pathData="M300,-20 C280,90 330,160 300,250 C275,328 315,400 290,500 C270,580 300,660 285,760"
        android:strokeAlpha="0.035"
        android:strokeColor="@color/veta_fuerte"
        android:strokeWidth="0.9" />

    <!-- Filo dorado bajo la veta: es el interior de la piedra asomando -->
    <path
        android:pathData="M-20,148 C62,118 102,198 177,173 C252,148 302,83 382,113"
        android:strokeAlpha="0.05"
        android:strokeColor="@color/oro_lamina_medio"
        android:strokeWidth="0.8" />
    <path
        android:pathData="M-20,512 C80,477 140,552 220,527 C290,505 330,552 380,532"
        android:strokeAlpha="0.045"
        android:strokeColor="@color/oro_lamina_medio"
        android:strokeWidth="0.8" />
</vector>
