<?xml version="1.0" encoding="utf-8"?>
<!-- Lámina de oro: el degradé del contrato aplanado a las tres paradas que
     admite un shape de Android. Va con texto tinta encima. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="315"
        android:centerColor="@color/oro_lamina_medio"
        android:endColor="@color/oro_oscuro"
        android:startColor="@color/oro_lamina_reflejo"
        android:type="linear" />
    <corners android:radius="@dimen/radio_chico" />
</shape>
